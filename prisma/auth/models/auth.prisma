model User {
    id        String   @id @unique @default(dbgenerated("uuidv7()")) @db.Uuid
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
    updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

    @@map("users")
    @@schema("public")
}

model RefreshToken {
    id         String   @id @unique @default(dbgenerated("uuidv7()")) @db.Uuid
    userId     String
    token      String   @unique
    created_at DateTime @default(now()) @db.Timestamp(6)

    @@map("refresh_tokens")
    @@schema("public")
}
