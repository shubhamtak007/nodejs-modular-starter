model User {
    id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
    name      String
    email     String    @unique
    password  String
    createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

    @@map("users")
    @@schema("public")
}

model RefreshToken {
    id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
    userId     String
    token      String
    created_at DateTime? @default(now()) @db.Timestamp(6)

    @@map("refresh_tokens")
    @@schema("public")
}
