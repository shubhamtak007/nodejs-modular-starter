{
    "compilerOptions": {
        "types": [
            "node"
        ],
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "ignoreDeprecations": "6.0",
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src",
        "*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}